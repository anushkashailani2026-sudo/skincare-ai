# ===================================================
# Skincare AI - Environment Configuration Example
# Copy this file to .env and customize for your environment
# ===================================================

# Database Connection (Hosted PostgreSQL for Render / Supabase / Neon)
# Leave empty for local development to use automatic local SQLite
DATABASE_URL=postgresql://username:password@hostname:5432/database_name

# Initial Admin Credentials (seeded on first startup into the database)
ADMIN_ID=admin
ADMIN_PASSWORD=change_this_secure_password_123

# Secret Key for secure sessions & cookies
SESSION_SECRET=generate_a_random_secure_hex_or_string_key_here

# Ollama API Key (for AI recommendations)
OLLAMA_API_KEY=your_ollama_cloud_api_key_here

# Environment (set to 'production' on Render)
NODE_ENV=development
